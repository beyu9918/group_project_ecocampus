{
  "name": "EcoCampusExchange",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y sqlite3 && npm install",
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },
  "extensions": [
    "dbaeumer.vscode-eslint"
  ]
}