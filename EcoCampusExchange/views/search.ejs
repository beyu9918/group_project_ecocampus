
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Search</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <h1>EcoCampus Search</h1>
  <form method="get" action="/search">
    <input type="text" name="keyword" placeholder="Keyword" value="<%= query.keyword || '' %>"/>
    <select name="category">
      <option value="">All Categories</option>
      <option value="textbook" <%= query.category === 'textbook' ? 'selected' : '' %>>Textbook</option>
      <option value="digital" <%= query.category === 'digital' ? 'selected' : '' %>>Digital</option>
    </select>
    <input type="number" name="minPrice" placeholder="Min Price" value="<%= query.minPrice || '' %>" />
    <input type="number" name="maxPrice" placeholder="Max Price" value="<%= query.maxPrice || '' %>" />
    <select name="minRating">
      <option value="">Any Rating</option>
      <option value="4" <%= query.minRating == 4 ? 'selected' : '' %>>4★+</option>
      <option value="3" <%= query.minRating == 3 ? 'selected' : '' %>>3★+</option>
    </select>
    <select name="sort">
      <option value="">Default</option>
      <option value="rating" <%= query.sort === 'rating' ? 'selected' : '' %>>Rating ↓</option>
      <option value="price" <%= query.sort === 'price' ? 'selected' : '' %>>Price ↑</option>
      <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest</option>
    </select>
    <button type="submit">Search</button>
  </form>

  <div class="item-list">
    <% if (items.length === 0) { %>
      <p>No matching results.</p>
    <% } else { %>
      <% items.forEach(item => { %>
        <div class="item">
          <h2><a href="/item/<%= item.id %>"><%= item.title %></a></h2>
          <p><%= item.description %></p>
          <p>Price: ¥<%= item.price %> | Rating: <%= item.avgRating %>★</p>
        </div>
      <% }) %>
    <% } %>
  </div>
</body>
</html>