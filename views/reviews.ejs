<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Rate Your Order</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <h1 style="text-align:center; margin:20px 0;">Rate Your Order</h1>

  <section style="max-width:600px; margin:0 auto;">
    <p>Order ID: <%= orderID %></p>

    <form id="review-form" style="display:flex; flex-direction:column; gap:12px;">
      <label>
        Select Product:
        <select name="productID" id="productSelect">
          <% items.forEach(function(item) { %>
            <option value="<%= item.productID %>"><%= item.productName %></option>
          <% }); %>
        </select>
      </label>

      <label>
        Rating:
        <select name="rating" id="ratingSelect">
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
          <option value="5">5</option>
        </select>
      </label>

      <label>
        Comment:
        <textarea name="comment" rows="4" placeholder="Write your review..." required style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;"></textarea>
      </label>

      <button type="submit" style="padding:12px; background:#4CAF50; color:#fff; border:none; border-radius:4px; cursor:pointer;">Submit Review</button>
    </form>
  </section>

  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const orderID = urlParams.get('orderID');
    // Fetch items for this order
    fetch(`/api/order/${orderID}`)
      .then(res => res.json())
      .then(order => {
        // populate items dropdown
        const select = document.getElementById('productSelect');
        select.innerHTML = '';
        order.items.forEach(item => {
          const opt = document.createElement('option');
          opt.value = item.productID;
          opt.textContent = item.productName;
          select.appendChild(opt);
        });
      });

    document.getElementById('review-form').addEventListener('submit', e => {
      e.preventDefault();
      const data = new FormData(e.target);
      const payload = {
        product_id: parseInt(data.get('productID'), 10),
        reviewer: '', // fill with userID/session on server side
        rating: parseInt(data.get('rating'), 10),
        comment: data.get('comment')
      };
      fetch('/api/reviews', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      }).then(res => {
        if (res.ok) {
          alert('Thank you for your feedback!');
          window.location.href = '/';
        } else {
          alert('Failed to submit review.');
        }
      });
    });
  </script>
</body>
</html>
