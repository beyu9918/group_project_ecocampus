<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
  <h1>Product Management Page</h1>
  <a href="/">Back to Home</a>
</body>
</html>


<form action="/product/addProduct">
    <button type="submit">Go to Add Product Page</button>
  </form>
  
  <h2>All Goods:</h2>
  <ul>
    <% if (goods && goods.length > 0) { %>
      <% goods.forEach(g => { %>
        <li>ID: <%= g.goodsID %>, Name: <%= g.goodsName %>, Price: $<%= g.goodsPrice %></li>
      <% }) %>
    <% } else { %>
      <li>No goods added yet.</li>
    <% } %>
  </ul>
  


  
  