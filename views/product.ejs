<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= product.title %> - Details</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
<div class="product-details">

  <h1 class="product-title"><%= product.title %></h1>

  <div class="product-info">
    <p><strong>Price:</strong> ¥<%= product.price %></p>
    <p><strong>Description:</strong> <%= product.description %></p>
    <p><strong>Seller:</strong> <%= seller?.name %> | Rating: <%= seller?.avgRating %>★</p>
    <p><strong>Product Rating:</strong> <%= product.avgRating %>★</p>
  </div>

  <h2 class="review-section-title">Submit Your Review</h2>

  <form action="/product/<%= product.id %>/review" method="post" class="review-form">
    <label>Rating:
      <select name="rating" required>
        <option value="">--Select--</option>
        <% for(let i = 1; i <= 5; i++) { %>
          <option value="<%= i %>"><%= i %>★</option>
        <% } %>
      </select>
    </label>
    <br />
    <label>Comment:
      <textarea name="comment" rows="4" cols="40" maxlength="300" required></textarea>
    </label>
    <br />
    <button type="submit" class="submit-button">Submit Review</button>
  </form>

  <h2 class="review-section-title">Reviews</h2>

  <% if (reviews.length === 0) { %>
    <p>No reviews yet.</p>
  <% } else { %>
    <% reviews.forEach(review => { %>
      <div class="review-card">
        <p><strong>Rating:</strong> <%= review.rating %>★</p>
        <p><%= review.comment %></p>
        <p><small><%= new Date(review.createTime).toLocaleString() %></small></p>
      </div>
    <% }) %>
  <% } %>

  <a class="back-button" href="/search">← Back to Search</a>

</div>
</body>
</html>