<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <h1>Product Management Page</h1>
  <a href="/">
    <button>Back to Home</button>
  </a>

  <h2>All Products:</h2>
  <ul>
    <% if (goods && goods.length > 0) { %>
      <% goods.forEach(g => { %>
        <li>Name: <%= g.goodsName %>, Price: $<%= g.goodsPrice %></li>
      <% }) %>
    <% } else { %>
      <li>No product added yet.</li>
    <% } %>
  </ul>

  <form action="/product/addProduct">
    <button type="submit">Add Product</button>
  </form>

</body>
</html>



  


  
  