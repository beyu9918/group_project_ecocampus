<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Reviews</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <div class="form-wrapper">
    <a href="/admin/users" class="link" style="text-align: left; margin-bottom: 20px;">← Back to User List</a>
    <h2>User Reviews</h2>
    <table>
      <thead>
        <tr>
          <th>Review ID</th>
          <th>Product ID</th>
          <th>Rating</th>
          <th>Comment</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% if (reviews.length > 0) { %>
          <% reviews.forEach(r => { %>
            <tr>
              <td><%= r.reviewid %></td>
              <td><%= r.productid %></td>
              <td><%= r.rating %> ★</td>
              <td><%= r.comment || '-' %></td>
              <td><%= new Date(r.createdat).toLocaleString() %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5">No reviews found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>