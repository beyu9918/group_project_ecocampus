<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Orders</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <div class="form-wrapper">
    <a href="/admin/users" class="link" style="text-align: left; margin-bottom: 20px;">← Back to User List</a>
    <h2>User Orders</h2>
    <table>
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Product ID</th>
          <th>Total Amount</th>
          <th>Placed At</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length > 0) { %>
          <% orders.forEach(order => { %>
            <tr>
              <td><%= order.orderid %></td>
              <td><%= order.productid %></td>
              <td>$<%= order.totalamount %></td>
              <td><%= new Date(order.placed_at).toLocaleString() %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4">No orders found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>