<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Products</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <div class="form-wrapper">
    <a href="/admin/users" class="link" style="text-align: left; margin-bottom: 20px;">← Back to User List</a>
    <h2>User Products</h2>
    <table>
      <thead>
        <tr>
          <th>Product ID</th>
          <th>Name</th>
          <th>Price</th>
          <th>Category</th>
          <th>Avg Rating</th>
        </tr>
      </thead>
      <tbody>
        <% if (products.length > 0) { %>
          <% products.forEach(p => { %>
            <tr>
              <td><%= p.productid %></td>
              <td><%= p.productname %></td>
              <td>$<%= p.productprice %></td>
              <td><%= p.category || '-' %></td>
              <td><%= p.avgrating || '-' %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5">No products found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>