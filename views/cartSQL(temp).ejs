<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Cart</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <div class="form-wrapper">
    <a href="/admin/users" class="link" style="text-align: left; margin-bottom: 20px;">← Back to User List</a>
    <h2>User Cart</h2>
    <table>
      <thead>
        <tr>
          <th>Cart ID</th>
          <th>Product ID</th>
          <th>Quantity</th>
          <th>Added At</th>
        </tr>
      </thead>
      <tbody>
        <% if (cart.length > 0) { %>
          <% cart.forEach(item => { %>
            <tr>
              <td><%= item.cartid %></td>
              <td><%= item.productid %></td>
              <td><%= item.quantity %></td>
              <td><%= new Date(item.added_at).toLocaleString() %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4">Cart is empty.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>