<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="/socket.io/socket.io.js"></script>
  <style>
    body {
      display: block !important;
      align-items: flex-start !important;
      justify-content: flex-start !important;
      height: auto !important;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <h1 style="text-align:center; margin:20px 0;"><%= title %></h1>

  <section style="max-width:800px; margin:0 auto;">
    <table style="width:100%; border-collapse:collapse;">
      <thead>
        <tr>
          <th style="text-align:left; padding:8px;">Product</th>
          <th style="text-align:center; padding:8px;">Quantity</th>
          <th style="text-align:right; padding:8px;">Price</th>
          <th style="text-align:right; padding:8px;">Subtotal</th>
        </tr>
      </thead>
      <tbody id="cart-body">
        <% items.forEach(function(item) { %>
        <tr data-id="<%= item.productID %>">
          <td style="padding:8px;"><%= item.productName %></td>
          <td style="padding:8px; text-align:center;">
            <button class="decrease" style="margin-right:4px;">−</button>
            <input type="number" class="qty" value="<%= item.quantity %>" min="1"
                   style="width:50px; text-align:center;" />
            <button class="increase" style="margin-left:4px;">+</button>
          </td>
          <td style="padding:8px; text-align:right;">$<%= item.productPrice.toFixed(2) %></td>
          <td style="padding:8px; text-align:right;" class="subtotal">
            $<%= (item.productPrice * item.quantity).toFixed(2) %>
          </td>
        </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" style="padding:8px; text-align:right; font-weight:bold;">Total:</td>
          <td id="total-price" style="padding:8px; text-align:right; font-weight:bold;">$0.00</td>
        </tr>
      </tfoot>
    </table>

    <div style="text-align:center; margin:20px 0;">
      <button id="placeOrder"
              style="padding:12px 24px; font-size:16px; cursor:pointer;">
        Place Order
      </button>
    </div>
  </section>

  <!-- Toast notification -->
  <div id="toast"></div>
  <script>
    const buyerID    = <%= JSON.stringify(buyerID) %>;
    const socket     = io();
    const cartBody   = document.getElementById('cart-body');
    const totalPrice = document.getElementById('total-price');
    const placeBtn   = document.getElementById('placeOrder');
    const toastEl    = document.getElementById('toast');

    function recalcTotal() {
      let total = 0;
      cartBody.querySelectorAll('tr').forEach(row => {
        const price = parseFloat(row.children[2].textContent.replace('$',''));
        const qty   = parseInt(row.querySelector('.qty').value, 10);
        total += price * qty;
        row.querySelector('.subtotal').textContent = '$' + (price * qty).toFixed(2);
      });
      totalPrice.textContent = '$' + total.toFixed(2);
    }

    cartBody.addEventListener('click', e => {
      if (e.target.matches('.decrease, .increase')) {
        const row = e.target.closest('tr');
        const input = row.querySelector('.qty');
        let v = parseInt(input.value, 10);
        if (e.target.classList.contains('decrease') && v > 1) v--;
        if (e.target.classList.contains('increase')) v++;
        input.value = v;
        recalcTotal();
      }
    });

    function showToast(message) {
      toastEl.textContent = message;
      toastEl.className = 'show';
      setTimeout(() => toastEl.className = '', 4000);
    }

    recalcTotal();

    placeBtn.addEventListener('click', () => {
      const items = [];
      cartBody.querySelectorAll('tr').forEach(row => {
        items.push({
          productID: parseInt(row.dataset.id, 10),
          quantity:  parseInt(row.querySelector('.qty').value, 10)
        });
      });

      fetch('/api/order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ buyerID, items })
      })
      .then(res => res.json())
      .then(({ orderID }) => {
        const ts = new Date()
          .toLocaleTimeString('en-GB', { hour12:false, timeZone:'Australia/Sydney' });
        showToast(`Order placed at ${ts}`);
        setTimeout(() => location.href = `/order/${orderID}`, 2500);
      })
      .catch(console.error);
    });
  </script>
</body>
</html>
