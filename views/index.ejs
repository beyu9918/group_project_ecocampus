<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Cart</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <h1>Your Cart</h1>

  <section>
    <% if (cart.length === 0) { %>
      <p>Your cart is empty.</p>
    <% } else { %>
      <ul>
        <% cart.forEach(item => { %>
          <li style="display:flex; align-items:center; justify-content: space-between;">
            <div style="display:flex; align-items:center;">
              <!-- placeholder image -->
              <img src="<%= item.product.productPicture || '' %>"
                   alt="<%= item.product.productName %>"
                   width="50" height="50"
                   style="margin-right:12px;">
              <div>
                <strong><%= item.product.productName %></strong><br>
                Price: $<%= parseFloat(item.product.productPrice).toFixed(2) %>
              </div>
            </div>

            <!-- quantity‐update form -->
            <form action="/cart/update" method="POST" style="display:flex; align-items:center;">
              <input
                type="hidden"
                name="productID"
                value="<%= item.product.productID %>"
              />
              <input
                type="number"
                name="quantity"
                min="1"
                value="<%= item.quantity %>"
                style="width:60px; margin-right:8px;"
              />
              <button type="submit">Update</button>
            </form>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <form action="/order" method="POST" style="margin-top: 20px;">
    <button type="submit" <% if (cart.length === 0) { %> disabled <% } %>>
      Place Order
    </button>
  </form>
</body>
</html>
