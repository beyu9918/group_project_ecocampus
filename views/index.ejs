<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Your Cart</title>
</head>
<body>
  <h1>Your Cart</h1>

  <ul>
    <% cart.forEach(item => { %>
      <li style="display: flex; align-items: center;">
        <img src="" alt="<%= item.product.productName %>" style="width:50px;height:50px;margin-right:10px;" />
        <div>
          <strong><%= item.product.productName %></strong><br/>
          Price: $<%= item.product.productPrice
               ? parseFloat(item.product.productPrice).toFixed(2)
               : '0.00' %>
        </div>
      </li>
    <% }); %>
  </ul>

  <form action="/order" method="POST" style="text-align:center; margin-top:2em;">
    <button type="submit">Place Order</button>
  </form>
</body>
</html>