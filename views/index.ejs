<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Cart</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <style>
    /* undo the flex-centering on body */
    body {
      display: block      !important;
      justify-content: flex-start !important;
      align-items:     flex-start !important;
      height: auto       !important;
    }
    /* undo the global h1 centering */
    h1 {
      text-align: left   !important;
    }
  </style>
</head>
<body style="padding-top: 60px;">
  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="nav-title">

      <a href="/product" style="text-decoration: none; color: inherit;">EcoCampus</a>
    </div>
    <div class="nav-right">
      <% if (user && user.name) { %>
        <a href="/profile"><button class="nav-button"><%= user.name %></button></a>
      <% } else { %>
        <a href="/login"><button class="nav-button">Login</button></a>
      <% } %>
      <a href="/index"><button class="nav-button">Shopping Cart</button></a>
      <a href="/orders"><button class="nav-button">Order Management</button></a>
      <a href="/messages"><button class="nav-button">My Messages</button></a>
      <% if (user && user.userid) { %>
        <a href="/user/<%= user.userid %>"><button class="nav-button">My Account</button></a>
      <% } %>
    </div>
  </nav>
  <h1>Your Cart</h1>

  <section>
    <% if (cart.length === 0) { %>
      <p>Your cart is empty.</p>
    <% } else { %>
      <ul>
        <% cart.forEach(item => { %>
          <li style="display:flex; align-items:center; justify-content: space-between;">
            <div style="display:flex; align-items:center;">
              <img src=""
                   alt="<%= item.productName %>"
                   width="50" height="50"
                   style="margin-right:12px;">
              <div>
                <strong><%= item.productName %></strong><br>
                Current Quantity: <%= item.quantity %><br>
                Price: $<%= parseFloat(item.productPrice).toFixed(2) %>
              </div>
            </div>

            <form action="/cart/update" method="POST" style="display:flex; align-items:center;">
              <input type="hidden" name="productID" value="<%= item.productID %>">
              <input type="number"
                     name="quantity"
                     min="1"
                     value="<%= item.quantity %>"
                     style="width:60px; margin-right:8px;">
              <button type="submit">Update</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <% if (user) { %>
    <form action="/order" method="POST" style="margin-top: 20px;">
      <button
        type="submit"
        <% if (cart.length === 0) { %> disabled <% } %>
      >
        Place Order
      </button>
    </form>
  <% } else { %>
   <a href="/login">
      <button type="button" style="margin-top: 20px;">
        Place Order
      </button>
   </a>
  <% } %>

  <!-- Share Cart Button -->
  <button id="shareBtn" style="margin-top: 20px;" <% if (cart.length === 0) { %> disabled <% } %>>
    Share Cart
  </button>

  <!-- Hidden textarea for the generated summary -->
  <textarea id="shareBox" readonly
            style="display:none; width:100%; height:120px; margin-top:10px; box-sizing:border-box;"></textarea>

  <!-- Copy button -->
  <button id="copyBtn" style="display:none; margin-top:5px;">
    Copy to Clipboard
  </button>

  <!-- Embed cart data for JS -->
  <script>
    const cartData = <%- JSON.stringify(cart.map(item => ({
      name: item.productName,
      quantity: item.quantity,
      price: parseFloat(item.productPrice).toFixed(2)
    }))) %>;

    const shareBtn = document.getElementById('shareBtn');
    const shareBox = document.getElementById('shareBox');
    const copyBtn  = document.getElementById('copyBtn');

    shareBtn.addEventListener('click', () => {
      // Build the text summary
      const lines = cartData.map(it =>
        `${it.name} x${it.quantity} – $${it.price}`
      );
      shareBox.value = lines.join('\n');
      shareBox.style.display = 'block';
      copyBtn.style.display  = 'inline-block';
      shareBox.select();
    });

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(shareBox.value)
        .then(() => {
          copyBtn.textContent = 'Copied!';
          setTimeout(() => copyBtn.textContent = 'Copy to Clipboard', 2000);
        })
        .catch(err => {
          console.error('Copy failed:', err);
        });
    });
  </script>
</body>
</html>
