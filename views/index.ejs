<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Shopping Page</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <script src="/socket.io/socket.io.js" defer></script>
</head>
<body>
  <!-- Page Title -->
  <h1 style="text-align:center; margin:20px 0;">Shopping Page</h1>

  <div style="display:flex; gap:16px; padding:20px; background:#f0f0f0; justify-content:center; flex-wrap:wrap;">
    <!-- Add to Cart -->
    <div style="background:#fff; padding:24px; border-radius:8px; box-shadow:0 2px 6px rgba(0,0,0,0.1); width:240px;">
      <h3>Add to Cart</h3>
      <input type="text" id="itemName" placeholder="Item name" style="width:100%; padding:8px; margin-bottom:10px;" />
      <div style="display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:10px;">
        <button id="decreaseQty" style="flex:1;">−</button>
        <span id="qtyDisplay" style="display:inline-block; width:50px; text-align:center;">1</span>
        <button id="increaseQty" style="flex:1;">+</button>
      </div>
      <button id="addItem" style="width:100%;">Add Items</button>
    </div>

    <!-- Shopping Cart -->
    <div style="background:#fff; padding:24px; border-radius:8px; box-shadow:0 2px 6px rgba(0,0,0,0.1); width:240px;">
      <h3>Shopping Cart</h3>
      <ul id="cart" style="list-style:none; padding:0; max-height:200px; overflow:auto;"></ul>
      <button id="shareBtn" style="width:100%; margin-top:10px;">Share Cart</button>
    </div>

    <!-- Order Status -->
    <div style="background:#fff; padding:24px; border-radius:8px; box-shadow:0 2px 6px rgba(0,0,0,0.1); width:240px;">
      <h3>Order Status</h3>
      <ul id="orders" style="list-style:none; padding:0; max-height:200px; overflow:auto;"></ul>
      <button id="placeOrder" style="width:100%; margin-top:10px;">Place Order</button>
    </div>

    <!-- Notifications -->
    <div style="background:#fff; padding:24px; border-radius:8px; box-shadow:0 2px 6px rgba(0,0,0,0.1); width:240px;">
      <h3>Notifications</h3>
      <ul id="notifications" style="list-style:none; padding:0; max-height:200px; overflow:auto;"></ul>
    </div>
  </div>

  <!-- Inline script runs after DOM is parsed -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const socket = io();
      const cartUl = document.getElementById('cart');
      const ordersUl = document.getElementById('orders');
      const notificationsUl = document.getElementById('notifications');

      const itemInput = document.getElementById('itemName');
      const qtyDisplay = document.getElementById('qtyDisplay');
      let qty = 1;
      const decBtn = document.getElementById('decreaseQty');
      const incBtn = document.getElementById('increaseQty');
      const addBtn = document.getElementById('addItem');
      const shareBtn = document.getElementById('shareBtn');
      const placeBtn = document.getElementById('placeOrder');

      // Quantity controls
      decBtn.addEventListener('click', () => {
        if (qty > 1) qty--;
        qtyDisplay.textContent = qty;
      });
      incBtn.addEventListener('click', () => {
        qty++;
        qtyDisplay.textContent = qty;
      });

      // Add items
      addBtn.addEventListener('click', () => {
        const name = itemInput.value.trim();
        if (!name) return;
        for (let i = 0; i < qty; i++) {
          fetch('/api/cart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: Date.now().toString(), name })
          });
        }
        itemInput.value = '';
        qty = 1;
        qtyDisplay.textContent = qty;
      });

      // Share entire cart
      shareBtn.addEventListener('click', () => {
        const items = Array.from(cartUl.children).map(li => li.textContent);
        if (!items.length) return alert('Cart is empty');
        fetch('/api/social/share', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: 'user42', listingIds: items })
        });
      });

      // Real-time updates
      socket.on('cartUpdated', items => {
        cartUl.innerHTML = '';
        items.forEach(i => {
          const li = document.createElement('li');
          li.textContent = i.name;
          cartUl.appendChild(li);
        });
      });
      socket.on('cartItemAdded', ({ item, timestamp }) => {
        const li = document.createElement('li');
        li.textContent = `${timestamp} — ${item.name}`;
        cartUl.appendChild(li);
      });
      socket.on('orderProcessed', ({ orderId, status, timestamp }) => {
        const li = document.createElement('li');
        li.textContent = `${timestamp} — Order ${orderId}: ${status}`;
        ordersUl.appendChild(li);
      });
      socket.on('notification', ({ type, message, timestamp }) => {
        const li = document.createElement('li');
        li.textContent = `[${timestamp}] [${type}] ${message}`;
        notificationsUl.appendChild(li);
      });

      // Place order
      placeBtn.addEventListener('click', () => {
        fetch('/api/order', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      });
    });
  </script>
</body>
</html>
