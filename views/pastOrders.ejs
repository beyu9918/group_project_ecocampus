<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Purchase History</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
<!-- Navigation Bar -->
  <nav class="navbar">
    <div class="nav-title">
      EcoCampus
    </div>
    <div class="nav-right">
      <% if (user && user.name) { %>
        <button class="nav-button"><%= user.name %></button>
      <% } else { %>
        <button class="nav-button">Login</button>
      <% } %>
      <button class="nav-button">Shopping Cart</button>
      <button class="nav-button">Order Management</button>
      <button class="nav-button">My Messages</button>
      <% if (user && user.userid) { %>
        <button class="nav-button">My Account</button>
      <% } %>
    </div>
  </nav>
  <h1>Your Purchase History</h1>

  <form action="/orders/clear" method="POST" style="margin-bottom:16px;">
    <button type="submit"
      <% if (!orders || orders.length === 0) { %> disabled <% } %>>
      Clear History
    </button>
  </form>

  <section>
    <% if (!orders || orders.length === 0) { %>
      <p>You have no past purchases.</p>
    <% } else { %>
      <ul>
        <% orders.forEach(order => { %>
          <li style="margin-bottom:12px;">
            <!-- show product name instead of a blank Product # -->
            <strong><%= order.productName %></strong>
            <!-- optionally show the ID too -->
            (Product #<%= order.productID %>) — 
            Purchased at <%= new Date(order.placedAt).toLocaleString() %>

            <form action="/product/<%= order.productID %>/comment"
                  method="GET"
                  style="display:inline; margin-left:12px;">
              <button type="submit">Comment</button>
            </form>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <p style="margin-top:16px;">
    <a href="/" class="link">Back to Cart</a>
  </p>
</body>
</html>
