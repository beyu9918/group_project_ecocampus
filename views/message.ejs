<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Message</title>
  <script src="/socket.io/socket.io.js"></script>
  <script type="module" src="/js/chat.js"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f2f2f2;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 60px;
      color: #333;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 50px;
      background-color: #2c3e50;
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 20px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      z-index: 1000;
    }

    .nav-title {
      font-size: 18px;
      font-weight: bold;
    }

    .nav-right {
      display: flex;
      align-items: center;
    }

    .nav-button {
      background-color: #4CAF50;
      color: white;
      border: none;
      padding: 8px 14px;
      border-radius: 4px;
      margin-left: 10px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .nav-button:hover {
      background-color: #388e3c;
    }

    .chat-container {
      background: white;
      width: 90%;
      max-width: 700px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      padding: 20px;
      margin-top: 20px;
    }

    #messages {
      border: 1px solid #ccc;
      border-radius: 6px;
      padding: 10px;
      min-height: 300px;
      max-height: 400px;
      overflow-y: auto;
      background: #fafafa;
      margin-bottom: 15px;
    }

    .msg {
      margin-bottom: 10px;
    }

    .msg strong {
      color: #2c3e50;
    }

    .chat-input {
      display: flex;
      gap: 10px;
    }

    #messageInput {
      flex: 1;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 14px;
    }

    #sendBtn {
      background-color: #4CAF50;
      color: white;
      border: none;
      padding: 10px 16px;
      border-radius: 6px;
      cursor: pointer;
    }

    #sendBtn:hover {
      background-color: #388e3c;
    }
  </style>
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="nav-title">

      <a href="/product" style="text-decoration: none; color: inherit;">EcoCampus</a>
    </div>
    <div class="nav-right">
      <% if (user && user.name) { %>
        <a href="/profile"><button class="nav-button"><%= user.name %></button></a>
      <% } else { %>
        <a href="/login"><button class="nav-button">Login</button></a>
      <% } %>
      <a href="/index"><button class="nav-button">Shopping Cart</button></a>
      <a href="/orders"><button class="nav-button">Order Management</button></a>
      <a href="/messages"><button class="nav-button">My Messages</button></a>
      <% if (user && user.userid) { %>
        <a href="/user/<%= user.userid %>"><button class="nav-button">My Account</button></a>
      <% } %>
    </div>
  </nav>

  <!-- Chat Box -->
  <div class="chat-container">
    <h2>Chat with <%= seller.name %> about "<%= product.productname %>"</h2>

    <div id="messages">
      <% if (typeof messages !== 'undefined') { %>
        <% messages.forEach(msg => { %>
          <div class="msg">
            <strong><%= msg.senderid === user.userid ? 'You' : seller.name %>:</strong>
            <%= msg.content %>
            <div style="font-size: 11px; color: #999;"><%= new Date(msg.sent_at).toLocaleString() %></div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="chat-input">
      <input type="text" id="messageInput" placeholder="Type a message..." />
      <button id="sendBtn">Send</button>
    </div>
  </div>

  <script>
    window.chatContext = {
      currentUserId: <%= user.userid %>,
      receiverId: <%= seller.userid %>,
      productId: <%= product.productid %>
    };
  </script>

</body>
</html>


