<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= user.name %>'s Profile</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="nav-title">
      <a href="/product" style="text-decoration: none; color: inherit;">EcoCampus</a>
    </div>
    <div class="nav-right">
      <% if (user && user.name) { %>
        <a href="/profile"><button class="nav-button"><%= user.name %></button></a>
        <a href="/logout"><button class="nav-button btn-red">Logout</button></a>
      <% } else { %>
        <a href="/login"><button class="nav-button">Login</button></a>
      <% } %>
      <a href="/cart"><button class="nav-button">Shopping Cart</button></a>
      <a href="/orders"><button class="nav-button">Order Management</button></a>
      <a href="/messages"><button class="nav-button">My Messages</button></a>
      <% if (user && user.userid) { %>
        <a href="/user/<%= user.userid %>"><button class="nav-button">My Account</button></a>
      <% } %>
    </div>
  </nav>
  <div class="form-wrapper">
    <h2><%= user.name %>'s Profile</h2>
    <img src="<%= user.avatar || '/uploads/default-avatar.png' %>" alt="Avatar" style="width:100px; height:100px; border-radius:50%;">
    <p><strong>Bio:</strong> <%= user.bio || 'No bio provided.' %></p>

    <h3>Products</h3>
    <% if (products.length === 0) { %>
      <p>No products posted.</p>
    <% } else { %>
      <ul>
        <% products.forEach(p => { %>
          <li style="margin-bottom: 20px;">
            <strong><%= p.productname %></strong> - $<%= p.productprice %><br>
            <% if (p.productpicture) { %>
              <img src="<%= p.productpicture %>" style="height: 80px; margin-top: 5px;"><br>
            <% } %>
            <em><%= p.category || 'Uncategorized' %></em><br>
            <small><%= p.description || 'No description.' %></small><br>
            <% if (p.avgrating) { %>
              <span>Rating: <%= p.avgrating %>★</span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <h3>Reviews</h3>
    <% if (reviews.length === 0) { %>
      <p>No reviews yet.</p>
    <% } else { %>
      <ul>
        <% reviews.forEach(r => { %>
          <li style="margin-bottom: 15px;">
            <strong><%= r.rating %>★</strong> - <%= r.comment %><br>
            <% if (r.productname) { %>
              <em>Product: <%= r.productname %></em><br>
            <% } %>
            <small>Reviewed on <%= new Date(r.createdat).toLocaleDateString() %></small>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</body>
</html>
