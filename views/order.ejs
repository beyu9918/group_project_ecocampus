<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Your Order</title>
  </head>
  <body>
    <% if (!confirmed) { %>
      <h1>Your Order</h1>
      <ul>
        <% items.forEach(item => { %>
          <li style="display:flex; align-items:center; margin-bottom:1em;">
            <!-- placeholder for product image -->
            <img src="" alt="<%= item.product.productName %>" width="50" height="50" style="margin-right:1em;">
            <div>
              <strong><%= item.product.productName %></strong><br/>
              Price: $<%= parseFloat(item.product.productPrice).toFixed(2) %><br/>
              Quantity: <%= item.quantity %>
            </div>
          </li>
        <% }) %>
      </ul>
      <p><strong>Total: $<%= total.toFixed(2) %></strong></p>
      <form action="/order/checkout" method="POST">
        <button type="submit">Checkout</button>
      </form>
      <p><a href="/">Back to Cart</a></p>

    <% } else { %>
      <h1>Order Confirmed</h1>
      <p>Thank you! Your order has been placed successfully.</p>
      <p><a href="/">Back to Cart</a></p>
    <% } %>
  </body>
</html>
