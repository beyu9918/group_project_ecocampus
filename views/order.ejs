<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= confirmed ? 'Order Confirmed' : 'Review Your Order' %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <style>
    /* undo the flex-centering on body */
    body {
      display: block      ;
      justify-content: flex-start ;
      align-items:     flex-start ;
      height: auto       ;
    }
    /* undo the global h1 centering */
    h1 {
      text-align: left   ;
    }
  </style>
</head>
<body style="padding-top: 60px;">
  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="nav-title">

      <a href="/product" style="text-decoration: none; color: inherit;">EcoCampus</a>
    </div>
    <div class="nav-right">
      <% if (user && user.name) { %>
        <a href="/profile"><button class="nav-button"><%= user.name %></button></a>
      <% } else { %>
        <a href="/login"><button class="nav-button">Login</button></a>
      <% } %>
      <a href="/index"><button class="nav-button">Shopping Cart</button></a>
      <a href="/orders"><button class="nav-button">Order Management</button></a>
      <a href="/messages"><button class="nav-button">My Messages</button></a>
      <% if (user && user.userid) { %>
        <a href="/user/<%= user.userid %>"><button class="nav-button">My Account</button></a>
      <% } %>
    </div>
  </nav>
  <% if (!confirmed) { %>
    <h1>Review Your Order</h1>
    <section>
      <% if (!items || items.length === 0) { %>
        <p>No items in your order.</p>
      <% } else { %>
        <ul>
          <% items.forEach(item => { %>
            <li style="display:flex; align-items:center; justify-content: space-between; margin-bottom:8px;">
              <div style="display:flex; align-items:center;">
                <img src=""
                     alt="<%= item.productName %>"
                     width="50" height="50"
                     style="margin-right:12px;">
                <div>
                  <strong><%= item.productName %></strong><br>
                  Quantity: <%= item.quantity %><br>
                  Price: $<%= parseFloat(item.productPrice).toFixed(2) %>
                </div>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>

    <p><strong>Total: $<%= total.toFixed(2) %></strong></p>

    <form action="/order/checkout" method="POST" style="margin-top:16px;">
      <input type="hidden" name="orderID" value="<%= orderID %>">
      <button type="submit" <% if (!items || items.length === 0) { %> disabled <% } %>>
        Checkout
      </button>
    </form>

    <p style="margin-top:12px;">
      <a href="/" class="link">Back to Cart</a>
    </p>

  <% } else { %>
    <h1>Order Confirmed</h1>
    <p>Thank you! Your order has been placed successfully.</p>

    <form action="/payment" method="GET" style="margin:20px 0;">
      <button type="submit">Proceed to Payment</button>
    </form>

    <p>
      <a href="/orders" class="link">View All Orders</a><br>
      <a href="/" class="link">Back to Cart</a>
    </p>
  <% } %>
</body>
</html>
