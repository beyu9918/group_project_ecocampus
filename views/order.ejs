<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Order <%= order.id %></title>
</head>
<body>
  <% if (confirmed) { %>
    <h1>Order <%= order.id %> Confirmed</h1>
    <p>Thank you! Your order has been confirmed.</p>
    <a href="/" class="button">Back to Cart</a>
  <% } else { %>
    <h1>Order <%= order.id %> Details</h1>
    <ul>
      <% cart.forEach(item => { %>
        <li>Product <%= item.productName %> — Quantity: <%= item.quantity %></li>
      <% }); %>
    </ul>
    <p>Total Price: $<%= order.totalAmount %></p>
    <form action="/order/<%= order.id %>/pay" method="POST">
      <button type="submit">Checkout</button>
    </form>
    <a href="/" class="button">Back to Cart</a>
  <% } %>
</body>
</html>